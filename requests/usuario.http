@baseUrl = http://localhost:3000
@username = usuario_teste
@email = usuario_teste@example.com
@senha = senha_teste_123
@usuarioToken = {{criarUsuario.response.body.$.token}}
@adminUsername = admin_existente
@adminSenha = senha_do_admin
@adminToken = {{loginAdmin.response.body.$.token}}

### Criar usuário aluno -> 201
# @name criarUsuario
POST {{baseUrl}}/usuario
Content-Type: application/json

{
  "nome": "João Batista",
  "username": "joao_btt",
  "email": "joao@gmail.com",
  "senha": "123456",
  "role": "aluno"
}

### Consultar perfil do usuário autenticado -> 200
GET {{baseUrl}}/profile
Authorization: Bearer {{usuarioToken}}

### Autenticar admin para operações administrativas
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "senha": "{{adminSenha}}"
}

### Listar usuários (somente admin) -> 200
GET {{baseUrl}}/usuario
Authorization: Bearer {{adminToken}}

### Buscar usuário por username (somente admin) -> 200
GET {{baseUrl}}/usuario/{{username}}
Authorization: Bearer {{adminToken}}

### Listar alunos (somente admin) -> 200
GET {{baseUrl}}/aluno
Authorization: Bearer {{adminToken}}

### Listar docentes (somente admin) -> 200
GET {{baseUrl}}/docente
Authorization: Bearer {{adminToken}}

### Listar administradores (somente admin) -> 200
GET {{baseUrl}}/admin
Authorization: Bearer {{adminToken}}

### Autenticar usuário criado
# @name loginUsuario
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "senha": "{{senha}}"
}

### Atualizar o próprio usuário -> 200
PUT {{baseUrl}}/usuario/{{username}}
Content-Type: application/json
Authorization: Bearer {{loginUsuario.response.body.$.token}}

{
  "nome": "Usuário de Teste Atualizado",
  "email": "usuario_teste_atualizado@example.com",
  "senha": "senha_teste_atualizada_123"
}

### Excluir o próprio usuário -> 204
DELETE {{baseUrl}}/usuario/{{username}}
Authorization: Bearer {{loginUsuario.response.body.$.token}}
