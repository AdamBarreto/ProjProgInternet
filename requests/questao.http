@baseUrl = http://localhost:3000
@docenteUsername = adam_sb
@docenteSenha = 123456
@token = {{loginDocente.response.body.$.token}}
@idQuestao = 8

### Autenticar com uma conta docente existente
# @name loginDocente
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "adam_sb",
  "senha": "123456"
}

### Criar questão
POST {{baseUrl}}/usuario/{{docenteUsername}}/questoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "enunciado": "Qual a maior estátua do mundo?",
  "etiqueta": "Conhecimentos Gerais",
  "tipo": "multipla_escolha",
  "gabarito": 3,
  "alternativas": [
    "Estátua da Liberdade",
    "Cristo Redentor",
    "Estátua da Unidade",
    "Estátua de Buda do Templo da Primavera"
  ]
}

### Exibir a questão criada -> 200
GET {{baseUrl}}/usuario/{{docenteUsername}}/questoes/{{idQuestao}}
Authorization: Bearer {{token}}

### Listar questões do docente autenticado -> 200
GET {{baseUrl}}/usuario/{{docenteUsername}}/questoes
Authorization: Bearer {{token}}

### Substituir questão e alternativas -> 200
PUT {{baseUrl}}/usuario/{{docenteUsername}}/questoes/{{idQuestao}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "enunciado": "Qual a montanha mais alta do mundo? (revisada)",
  "etiqueta": "Geografia",
  "tipo": "multipla_escolha",
  "gabarito": 2,
  "alternativas": [
    "Monte Aconcágua",
    "Monte Everest",
    "Monte Kilimanjaro",
    "Monte Fuji"
  ]
}

### Excluir a questão criada -> 204
DELETE {{baseUrl}}/usuario/{{docenteUsername}}/questoes/{{idQuestao}}
Authorization: Bearer {{token}}
